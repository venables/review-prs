#!/usr/bin/env bash
# autoreview: review the current repo's open PRs headlessly -- no terminal
# tabs. Each PR is reviewed by a `claude -p` subprocess; the run shows live
# per-PR progress, prints a summary, and exits nonzero if any review failed.
#
# This is the sibling of `review-prs`, which fans the same PRs out into one
# terminal tab each. Both share lib/: PR listing, ranking, the picker and
# session continuity are identical, so the two agree on what is worth
# reviewing and on which session a PR belongs to.
#
# Pick this one when there is no terminal to spawn into (ssh, cron, CI), when
# the exit status has to mean "the reviews succeeded" rather than "the tabs
# opened", or when a dozen PRs would mean a dozen tabs. Pick review-prs when
# you want to watch a review happen and steer it mid-flight.
#
# Losing the tab does not lose the review: a PR with no session yet gets a
# derived id pinned to it, so `claude --resume <id>` reopens the review
# afterwards and --continue re-enters it here. The summary prints the session
# each review actually ran in -- read back from the result envelope, because a
# run that did not pin an id cannot know it any other way.
#
# Prompts, by mode:
#   fresh               /panel-review N
#   fresh, unattended   /auto-review N     (--auto / --babysit)
#   resumed             /recheck-pr N      (--continue, and every babysit pass
#                                           after the first)
# Skills are invoked by slash name rather than in prose: an unattended one-shot
# has no human to correct a prompt that failed to trigger the skill.
#
# --babysit re-runs the whole pass on an interval, dropping PRs as they become
# APPROVED and resuming the rest, until nothing is left. Unlike review-prs --
# which seeds an in-session /loop inside each tab -- the loop is this script,
# so an interval that never converges is one process you can see and kill.

set -euo pipefail

# --- Library --------------------------------------------------------------
# Resolve this file through any symlinks before looking for lib/: the documented
# manual install symlinks the entry point into /usr/local/bin, and the library
# lives next to the real file, not next to the link.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
lib_dir="$(cd "$(dirname "$self")/lib" 2>/dev/null && pwd)" || {
  printf 'error: cannot find lib/ next to %s\n' "$self" >&2
  exit 1
}
# shellcheck source=lib/interval.sh
. "$lib_dir/interval.sh"
# shellcheck source=lib/repo.sh
. "$lib_dir/repo.sh"
# shellcheck source=lib/session.sh
. "$lib_dir/session.sh"
# shellcheck source=lib/pr-list.sh
. "$lib_dir/pr-list.sh"

# --- Args ----------------------------------------------------------------
include_approved=0
include_dependabot=0
auto=0
babysit=0
continue_sessions=0
jobs_max="${AUTOREVIEW_JOBS:-2}"
timeout="${AUTOREVIEW_TIMEOUT:-3600}"
max_budget="${AUTOREVIEW_MAX_BUDGET_USD:-}"
log_dir="${AUTOREVIEW_LOG_DIR:-}"

print_help() {
  cat <<'EOF'
autoreview: review open PRs headlessly, with progress and a real exit status.

Usage: autoreview [--auto] [--babysit[=MINUTES]] [--continue] [--jobs N]
                  [--timeout SECONDS] [--budget USD] [--log-dir DIR]
                  [--all] [--dependabot] [--help]

  --auto, -A          Skip the picker; review every NEW/UPDATED PR.
  --babysit[=MIN], -b Re-run the pass every MIN minutes (default 30, or
                      $AUTOREVIEW_BABYSIT_INTERVAL), dropping PRs as they are
                      approved, until none are left. A bare number is minutes;
                      30m/1h/2d also work.
  --continue, -C      Resume this machine's earlier review session for a PR
                      (a second look at the findings) instead of reviewing it
                      from scratch. Marked RESUMABLE in the picker.
  --jobs N, -j N      Reviews to run at once (default 2, or $AUTOREVIEW_JOBS).
                      Keep it low: a panel review is itself several agents.
  --timeout SECONDS   Give up on a review that runs this long (default 3600,
                      or $AUTOREVIEW_TIMEOUT; 0 disables).
  --budget USD        Cap each review's API spend (claude --max-budget-usd).
  --log-dir DIR       Where to write per-PR output (default: a temp directory,
                      printed on every run).
  --all, -a           Include PRs already marked APPROVED (default: exclude).
  --dependabot, -d    Include Dependabot PRs (default: hidden; shown dimmed).
  --help, -h          Show this help.

Each PR is reviewed by:
  claude -p --dangerously-skip-permissions --output-format json \
    --session-id UUID "/panel-review N"
where UUID is derived from the repo directory plus owner/name#N, so the same PR
in this checkout always maps to the same session -- and `claude --resume UUID`
reopens it interactively later. Override the reviewer via $AUTOREVIEW_CMD, or
$AUTOREVIEW_AUTO_CMD for --auto/--babysit runs (the PR number replaces the
first "{}", or is appended if absent):
  AUTOREVIEW_CMD='my-review'                           (append form)
  AUTOREVIEW_CMD='gh pr checkout {} && my-review {}'   (placeholder form)
An overridden command owns its own session handling; it receives the id as
$REVIEW_PRS_SESSION_ID and a 0/1 $REVIEW_PRS_SESSION_RESUME.

Exit status is 0 only when every review in the final pass succeeded.

To fan the same PRs into terminal tabs you can watch and steer instead, use
`review-prs`.

Your own PRs are always hidden -- this tool is for reviewing others' work.
EOF
}

# Reject a flag value early rather than letting it reach a sleep, a slot count
# or claude itself, where the failure would be far from its cause.
require_int() {
  local flag="$1" value="$2" min="$3"
  if [[ ! "$value" =~ ^[0-9]+$ ]] || [[ "$value" -lt "$min" ]]; then
    printf 'error: %s expects an integer >= %s, got "%s"\n' "$flag" "$min" "$value" >&2
    exit 1
  fi
}

# Both spellings of a flag need a value: "--flag value" is checked before the
# shift, "--flag=value" after unpacking. A bare "--budget=" would otherwise pass
# silently for an empty cap and leave an unattended sweep spending uncapped,
# while the same typo written "--budget ''" is refused -- one of them is wrong.
require_value() {
  if [[ -z "${2:-}" ]]; then
    printf 'error: %s expects a value\n' "$1" >&2
    exit 1
  fi
}

# Kept raw until after arg parsing: validating here would make a bad
# $AUTOREVIEW_BABYSIT_INTERVAL in your shell profile hard-fail every run,
# including --help and ordinary picker runs that never babysit.
babysit_interval_raw="${AUTOREVIEW_BABYSIT_INTERVAL:-30}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --auto|-A)       auto=1; shift ;;
    --babysit|-b)    babysit=1; shift ;;
    --babysit=*)     babysit=1; babysit_interval_raw="${1#*=}"; shift ;;
    --continue|-C)   continue_sessions=1; shift ;;
    --jobs|-j)       require_value "$1" "${2:-}"; jobs_max="$2"; shift 2 ;;
    --jobs=*|-j=*)   jobs_max="${1#*=}"
                     require_value "--jobs" "$jobs_max"; shift ;;
    --timeout)       require_value "$1" "${2:-}"; timeout="$2"; shift 2 ;;
    --timeout=*)     timeout="${1#*=}"
                     require_value "--timeout" "$timeout"; shift ;;
    --budget)        require_value "$1" "${2:-}"; max_budget="$2"; shift 2 ;;
    --budget=*)      max_budget="${1#*=}"
                     require_value "--budget" "$max_budget"; shift ;;
    --log-dir)       require_value "$1" "${2:-}"; log_dir="$2"; shift 2 ;;
    --log-dir=*)     log_dir="${1#*=}"
                     require_value "--log-dir" "$log_dir"; shift ;;
    --all|-a)        include_approved=1; shift ;;
    --dependabot|-d) include_dependabot=1; shift ;;
    --help|-h)       print_help; exit 0 ;;
    *)               printf 'unknown arg: %s\n' "$1" >&2; print_help >&2; exit 1 ;;
  esac
done

require_int "--jobs" "$jobs_max" 1
require_int "--timeout" "$timeout" 0
if [[ -n "$max_budget" && ! "$max_budget" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  printf 'error: --budget expects a dollar amount, got "%s"\n' "$max_budget" >&2
  exit 1
fi
# A cap of zero is never what anyone meant, and it is ambiguous in the worst
# place: it either fails every review in the sweep or is read as "no cap" and
# spends freely. Every other numeric flag here rejects zero for the same reason.
if [[ -n "$max_budget" && "$max_budget" =~ ^0*([.]0*)?$ ]]; then
  printf 'error: --budget expects a positive dollar amount, got "%s"\n' "$max_budget" >&2
  exit 1
fi

# Validate the interval only when babysitting is actually on, so an unrelated
# bad env var never blocks a plain run.
babysit_interval=""
if [[ "$babysit" -eq 1 ]]; then
  babysit_interval="$(normalize_interval "$babysit_interval_raw")" || exit 1
fi

# The reviewer to run, and its unattended twin. Empty means "use the built-in
# claude invocation", which needs the PR number and the session state to pick
# its flags and prompt and so cannot be flattened into a template string here.
review_cmd="${AUTOREVIEW_CMD:-}"
auto_review_cmd="${AUTOREVIEW_AUTO_CMD:-}"
if [[ "$auto" -eq 1 || "$babysit" -eq 1 ]]; then
  # An unattended run takes the unattended override. Falling silently back to
  # the built-in reviewer here would be the expensive kind of surprise: you
  # replaced the reviewer, and an unwatched sweep spends real money running an
  # agent under --dangerously-skip-permissions anyway. Say which one is running.
  if [[ -n "$review_cmd" && -z "$auto_review_cmd" ]]; then
    printf 'note: $AUTOREVIEW_CMD is set but $AUTOREVIEW_AUTO_CMD is not; %s runs the built-in reviewer\n' \
      "$([[ "$auto" -eq 1 ]] && printf -- '--auto' || printf -- '--babysit')" >&2
  fi
  review_cmd="$auto_review_cmd"
fi

# --- Context + selection --------------------------------------------------
# gum is required by the picker alone (see run_picker), so an --auto sweep runs
# on a box that has never seen it. pgrep is not optional here the way it is for
# a tab spawner: stopping a review walks the process tree with it, and without
# it a timeout would report a stopped review while the whole tree kept running.
require_deps gh jq pgrep
if [[ -z "$review_cmd" ]] && ! command -v claude >/dev/null 2>&1; then
  echo "error: missing required command: claude" >&2
  echo "  install it from https://claude.com/claude-code, or set \$AUTOREVIEW_CMD" >&2
  exit 1
fi
load_repo_context
# `if`, not `&&`: a false test as the last statement of a line would trip
# errexit and exit the script before anything is selected.
if [[ "$continue_sessions" -eq 1 ]]; then
  require_session_ids
fi
select_prs

if [[ -z "$log_dir" ]]; then
  log_dir="$(mktemp -d "${TMPDIR:-/tmp}/autoreview.XXXXXX")"
fi
mkdir -p "$log_dir"
# Everything this run writes goes under a directory of its own. A --log-dir is
# a fixed path -- the point of passing one -- and the cron use this tool is for
# makes overlapping runs ordinary, with the default hour-long timeout longer
# than most intervals. Sharing the pass directory would have each run reading
# the other's status files and reporting its results as though they were its
# own, which would corrupt the exit status the tool exists to provide.
#
# Made rather than named: a pid-named directory would be inherited by whichever
# later run the kernel hands that pid to, and a persistent --log-dir on a
# container -- low pids, recycled fast -- would put that run inside an older
# one's state, resuming sessions that were never its own.
run_dir="$(mktemp -d "$log_dir/run-XXXXXX")"

# --- Job pool -------------------------------------------------------------
# Bash 3.2 -- still what macOS ships -- has no `wait -n`, and `kill -0` on a
# finished child keeps succeeding until it is reaped. So a job announces its own
# completion by writing its exit status to a file, under a temp name and moved
# into place so a half-written status can never be read. The loop that watches
# for those files is also the loop that redraws the display, which is why
# scheduling and rendering are one loop and not two.
#
# State is parallel arrays indexed by queue position (bash 3.2 has no
# associative arrays):
q_pr=()      # PR number
q_state=()   # queued | running | done | failed | timeout
q_pid=()     # job subshell pid, while running
q_sid=()     # derived session id
q_flag=()    # "--session-id UUID" / "--resume UUID" / ""
q_resume=()  # 1 when this job resumes an earlier session
q_start=()   # epoch seconds
q_end=()     # epoch seconds
q_status=()  # exit status, once finished

pass_dir=""
rendered_lines=0
window_max=0
spin=0
# Double-quoted so the trailing backslash is an escaped literal: |/-\
spin_frames="|/-\\"
tty=0
poll_interval=1
if [[ -t 1 ]]; then tty=1; poll_interval=0.2; fi

job_file() { printf '%s/pr-%s.%s' "$pass_dir" "${q_pr[$1]}" "$2"; }

# True when a job is no longer running. `kill -0` alone cannot tell: a finished
# child keeps answering it until this shell reaps it, and nothing reaps it until
# finish_job waits -- which is what this decides. A dead-but-unreaped child is a
# zombie, so ask for the process state as well.
job_vanished() {
  local pid="$1" state
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 0
  state="$(ps -o state= -p "$pid" 2>/dev/null | tr -d ' ')"
  [[ "$state" == Z* ]]
}

fmt_dur() {
  local s="$1"
  if   [[ "$s" -ge 3600 ]]; then printf '%dh%02dm' $((s / 3600)) $(((s % 3600) / 60))
  elif [[ "$s" -ge 60   ]]; then printf '%dm%02ds' $((s / 60)) $((s % 60))
  else                           printf '%ds' "$s"
  fi
}

# The prompt for one PR. Resuming and reviewing from scratch are different jobs,
# so they get different prompts: a resumed session already holds the earlier
# review, which is exactly what recheck-pr needs and what a fresh panel review
# would throw away.
headless_prompt() {
  local i="$1" n="${q_pr[$1]}"
  if [[ "${q_resume[i]}" -eq 1 ]]; then
    printf '/recheck-pr %s' "$n"
  elif [[ "$auto" -eq 1 || "$babysit" -eq 1 ]]; then
    printf '/auto-review %s' "$n"
  else
    printf '/panel-review %s' "$n"
  fi
}

# Runs inside the job subshell, with stdout on the JSON envelope and stderr on
# the log. Unlike review-prs -- whose tab is a new shell it can only reach
# through a command string -- we spawn the child ourselves, so the session
# variables an override reads go into its real environment.
review_for() {
  local i="$1" n="${q_pr[$1]}"
  cd "$repo_root" || return 1

  if [[ -n "$review_cmd" ]]; then
    local invocation
    if [[ "$review_cmd" == *"{}"* ]]; then
      invocation="${review_cmd//\{\}/$n}"
    else
      invocation="$review_cmd $n"
    fi
    REVIEW_PRS_SESSION_ID="${q_sid[i]}" REVIEW_PRS_SESSION_RESUME="${q_resume[i]}" \
      bash -c "$invocation"
    return
  fi

  local argv=(claude -p --dangerously-skip-permissions --output-format json)
  if [[ -n "${q_flag[i]}" ]]; then
    # Two fixed words ("--resume UUID"), never user content, so splitting the
    # planned flag back apart is safe and keeps plan_session's single output.
    local flag_words=()
    read -r -a flag_words <<<"${q_flag[i]}"
    argv+=("${flag_words[@]}")
  fi
  if [[ -n "$max_budget" ]]; then
    argv+=(--max-budget-usd "$max_budget")
  fi
  argv+=("$(headless_prompt "$i")")
  "${argv[@]}"
}

run_job() {
  local i="$1" rc=0 status_file
  status_file="$(job_file "$i" status)"
  set +e
  review_for "$i" >"$(job_file "$i" json)" 2>"$(job_file "$i" log)"
  rc=$?
  printf '%s' "$rc" >"$status_file.tmp"
  mv "$status_file.tmp" "$status_file"
}

# The session an earlier pass of this run actually used for a PR, recorded by
# finish_job. Only --babysit produces a second pass, and only this file makes it
# resume the review it just ran: plan_session derives its id from the repo and
# PR number alone, so where a session already existed before the run, pass 1
# left it untouched and reviewed under an id claude allocated -- and pass 2
# would otherwise resume the older session and re-check findings nobody wrote.
#
# Per run, not per log dir. Two runs can share a --log-dir -- under cron they
# routinely do -- and a shared file would have each overwriting the other's
# answer, so a later pass could resume the other run's review of the same PR.
# A log dir shared between two checkouts would be worse still: PR #9 means a
# different PR in each, and resuming across them would defeat the whole point
# of hashing the checkout into the id (see lib/session.sh).
run_session_file() { printf '%s/session-%s.id' "$run_dir" "$1"; }

# Set when a pass could not review a PR. Recording nothing for a failure is not
# enough on its own: with no recorded id the next pass falls through to
# plan_session, which resumes the derived session whenever a transcript exists
# on disk -- so a review that failed here would still be "re-checked" against
# whatever an earlier run left behind. The marker says explicitly that this run
# has no review of that PR to check.
run_failed_file() { printf '%s/failed-%s' "$run_dir" "$1"; }

start_job() {
  local i="$1" prior="" prior_busy=0 fresh=0
  # Only consulted when resuming is on the table at all: without --continue this
  # branch cannot be taken, and checking anyway would print a note about a
  # session the run was never going to touch.
  if [[ "$continue_sessions" -eq 1 && -f "$(run_session_file "${q_pr[i]}")" ]]; then
    prior="$(cat "$(run_session_file "${q_pr[i]}")")"
    # The id goes into a command line unquoted, so anything that is not one is
    # dropped rather than word-split into argv.
    [[ "$prior" =~ ^[0-9a-fA-F-]{36}$ ]] || prior=""
  fi
  # Same guard plan_session applies to a derived id: a session another process
  # still holds must not be resumed, or two agents write one transcript. The
  # summary tells you to open `claude --resume <id>`, so a babysit interval is
  # exactly when someone is holding one.
  if [[ -n "$prior" ]] && session_in_use "$prior"; then
    queue_note "note: PR #${q_pr[i]} has its review session open elsewhere; reviewing fresh"
    prior=""
    prior_busy=1
  fi
  # A pass that failed leaves nothing to re-check, whatever is on disk.
  if [[ -f "$(run_failed_file "${q_pr[i]}")" ]]; then
    fresh=1
  fi
  if [[ "$prior_busy" -eq 1 || "$fresh" -eq 1 ]]; then
    # Deliberately not resuming. Where a recorded id exists at all it is this
    # run's own review, and the derived one names something older -- resuming
    # that is the stale re-check the recording exists to prevent.
    #
    # Pinning is a different question from resuming, though: a PR whose derived
    # session does not exist yet still gets that id, so this review is reachable
    # afterwards and an override still receives the id it is promised. Only
    # where a transcript already exists is the id withheld, because pinning a
    # taken id is a hard error.
    local derived
    derived="$(pr_session_id "${q_pr[i]}")"
    if [[ -n "$derived" ]] && ! session_exists "$derived"; then
      q_sid[i]="$derived"
      q_flag[i]="--session-id $derived"
    else
      q_sid[i]=""
      q_flag[i]=""
    fi
    q_resume[i]=0
  elif [[ -n "$prior" ]]; then
    q_sid[i]="$prior"
    q_flag[i]="--resume $prior"
    q_resume[i]=1
  else
    # plan_session speaks to stderr when it refuses to resume a live session.
    # Catch that in a file rather than a command substitution, which would run
    # it in a subshell and lose the three globals it exists to set.
    plan_session "${q_pr[i]}" 2>"$pass_dir/plan-note.tmp"
    if [[ -s "$pass_dir/plan-note.tmp" ]]; then
      queue_note "$(cat "$pass_dir/plan-note.tmp")"
    fi
    rm -f "$pass_dir/plan-note.tmp"
    q_sid[i]="$session_id"
    q_flag[i]="$session_flag"
    q_resume[i]="$session_resume"
  fi
  rm -f "$(job_file "$i" status)"
  run_job "$i" &
  q_pid[i]=$!
  q_start[i]="$(date +%s)"
  q_state[i]="running"
  note_transition "$i"
}

# claude -p can exit 0 and still report a failed turn in its envelope, so a zero
# exit is not on its own a successful review.
#
# The built-in reviewer is held to more than that: it was asked for JSON, so
# anything else -- empty output, a truncated write, a plain-text error line --
# means the review did not finish, whatever the exit status said. An overridden
# reviewer is judged on its exit status alone; prose on stdout is its normal
# shape, not a failure.
job_reported_error() {
  local out flag
  out="$(job_file "$1" json)"
  if [[ -n "$review_cmd" ]]; then
    [[ -s "$out" ]] || return 1
    flag="$(jq -r 'if type == "object" then (.is_error // false) else false end' \
      "$out" 2>/dev/null || printf 'false')"
    [[ "$flag" == "true" ]]
    return
  fi
  [[ -s "$out" ]] || return 0
  flag="$(jq -r 'if type == "object" then (.is_error // false) else "malformed" end' \
    "$out" 2>/dev/null || printf 'malformed')"
  [[ "$flag" != "false" ]]
}

# The session the review actually ran in, straight from the result envelope.
# This is the only trustworthy source: where a session already existed and
# --continue was not passed, no session flag was sent at all and claude
# allocated its own id, so the derived id names a different, older review.
job_session_id() {
  local out sid
  out="$(job_file "$1" json)"
  [[ -s "$out" ]] || return 0
  sid="$(jq -r 'if type == "object" then (.session_id // empty) else empty end' \
    "$out" 2>/dev/null || true)"
  [[ "$sid" =~ ^[0-9a-fA-F-]{36}$ ]] && printf '%s' "$sid"
  # An envelope with no usable session id is the ordinary case for an overridden
  # reviewer that prints prose. Returning the test's own false here would abort
  # the run at its caller's assignment, under errexit, with every review already
  # finished -- so end on a success the caller can read as "nothing to record".
  return 0
}

finish_job() {
  local i="$1" now="$2" raw="$3" sid ok=0
  q_end[i]="$now"
  wait "${q_pid[i]}" 2>/dev/null || true
  q_status[i]="$raw"
  if [[ "$raw" == "0" ]] && ! job_reported_error "$i"; then ok=1; fi

  # Only a review that finished is worth resuming. /recheck-pr against a failed
  # one has no findings to check, so it reports nothing to fix and never
  # approves -- and a babysit loop would re-spend on that PR every interval for
  # as long as it runs. The marker is what makes the next pass review fresh
  # rather than fall back to whatever session is on disk.
  if [[ "$ok" -eq 1 ]]; then
    rm -f "$(run_failed_file "${q_pr[i]}")"
  else
    : >"$(run_failed_file "${q_pr[i]}")"
  fi

  # Correct the recorded id before anything reports it: the summary tells you to
  # reopen this review with it, and a babysit pass resumes it.
  sid="$(job_session_id "$i")"
  if [[ -n "$sid" ]]; then
    q_sid[i]="$sid"
    if [[ "$ok" -eq 1 ]]; then
      # Written the way the status file is, and for the same reason: a reader
      # must never see half an id.
      printf '%s' "$sid" >"$(run_session_file "${q_pr[i]}").tmp"
      mv "$(run_session_file "${q_pr[i]}").tmp" "$(run_session_file "${q_pr[i]}")"
    fi
  elif [[ -z "${q_flag[i]}" || -n "$review_cmd" ]]; then
    # Nothing here knows which session this review landed in: either no flag was
    # sent, or an override ran and owns its own session handling -- it was
    # offered an id, and whether it used it is its business. The summary says to
    # reopen the review with what this column holds, so an id nobody can promise
    # exists does not belong in it.
    q_sid[i]=""
  fi
  if [[ "$raw" == "timeout" ]]; then
    q_state[i]="timeout"
  elif [[ "$ok" -eq 1 ]]; then
    q_state[i]="done"
  else
    q_state[i]="failed"
  fi
  note_transition "$i"
}

# A process and everything under it, deepest first, one pid per line. Killing
# only the job subshell is not enough: a reviewer spawns its own children (a
# panel review is several agents), and an orphaned tree keeps spending, keeps
# holding the session open -- so the next --continue refuses to resume it -- and
# keeps whatever stdout it inherited open long after this script exits.
#
# Job control (`set -m`, then one signal to the process group) would do this in
# one call, but it makes bash announce every killed job on stderr, which lands
# in the middle of the redrawn progress block. Walking the tree is quiet.
process_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    process_tree "$child"
  done
  printf '%s\n' "$pid"
}

signal_pids() {
  local sig="$1"; shift
  local p
  for p in "$@"; do
    kill -"$sig" "$p" >/dev/null 2>&1 || true
  done
}

# Stop a job that has outrun --timeout, or that Ctrl-C caught. Best-effort by
# design: a review we cannot reach is reported as a timeout either way, and the
# pass moves on rather than blocking a slot forever.
#
# The tree is snapshotted before anything is signalled, and that list is what
# every later signal goes to. Walking it again after the first TERM would find
# less than it should: the job subshell dies immediately, and a child that
# outlives it is reparented away, so ancestry can no longer reach the very
# processes still running. The snapshot still can.
#
# TERM first, then KILL: finish_job waits on the job, and a reviewer that
# ignores TERM would make that wait block forever -- turning --timeout, whose
# whole job is to stop a review that will not end, into the thing that hangs the
# run. KILL cannot be ignored, so the wait always returns.
#
# The second walk is for the other race: a reviewer that forked while we were
# taking the first snapshot has a child neither list has seen yet.
#
# Matching the session id with `pkill -f` would be a wider net, and too wide:
# the id is on the command line of every process that carries it, including the
# interactive `claude --resume <id>` the summary tells you to open and any
# concurrent run reviewing the same PR. One timeout here must not kill those.
stop_job() {
  local pid="$1" tree=() more=() p q
  while IFS= read -r p; do tree+=("$p"); done < <(process_tree "$pid")
  signal_pids TERM "${tree[@]}"
  sleep 0.2
  # Re-discovered from every pid already known, not just the root: the root is
  # usually the first thing to die, and from a dead pid nothing below it can be
  # found any more. A reviewer that outlived the TERM and forked after the first
  # snapshot is reachable only through itself.
  for p in "${tree[@]}"; do
    while IFS= read -r q; do more+=("$q"); done < <(process_tree "$p")
  done
  tree+=(${more[@]+"${more[@]}"})
  signal_pids TERM "${tree[@]}"
  sleep 0.2
  signal_pids KILL "${tree[@]}"
}

# Notes raised while the progress block is on screen have nowhere good to go:
# printing one scrolls the block and leaves $rendered_lines pointing at the
# wrong row, so every later redraw walks over whatever is there now. Hold them
# and flush after the pass. Without a TTY there is no block to disturb.
pass_notes=()
queue_note() {
  if [[ "$tty" -eq 1 ]]; then
    pass_notes+=("$1")
  else
    printf '%s\n' "$1" >&2
  fi
}

flush_notes() {
  local n
  for n in ${pass_notes[@]+"${pass_notes[@]}"}; do
    printf '%s\n' "$n" >&2
  done
  pass_notes=()
}

# Without a TTY -- a cron run, or output piped to a log -- there is no cursor to
# move, so the in-place block is replaced by one line per state change.
# How a failed job failed, in the words the reader needs: an exit status when
# there was one, and otherwise the fact that the job left no result at all.
job_outcome() {
  if [[ "${q_status[$1]}" == "vanished" ]]; then
    printf 'no result'
  else
    printf 'exit %s' "${q_status[$1]}"
  fi
}

note_transition() {
  if [[ "$tty" -eq 1 ]]; then return 0; fi
  local i="$1" n="${q_pr[$1]}"
  # The duration is computed per branch, not up front: on the "running"
  # transition there is no end time yet, and subtracting from zero would make a
  # nonsense number that today is only unprinted by luck.
  case "${q_state[i]}" in
    running) printf 'start   #%s\n' "$n" ;;
    done)    printf 'done    #%s (%s)\n' "$n" "$(fmt_dur $((q_end[i] - q_start[i])))" ;;
    failed)  printf 'FAILED  #%s (%s, %s)\n' "$n" "$(job_outcome "$i")" \
               "$(fmt_dur $((q_end[i] - q_start[i])))" ;;
    timeout) printf 'TIMEOUT #%s (%s)\n' "$n" "$(fmt_dur $((q_end[i] - q_start[i])))" ;;
  esac
}

# How many rows the progress block may occupy. The block is redrawn by moving
# the cursor up over itself, and the cursor cannot climb past the top of the
# window -- so a queue taller than the terminal would redraw onto rows it does
# not own, corrupting the display and the scrollback above it. A busy repo makes
# this ordinary rather than exotic: the PR query fetches 50, and --auto queues
# every NEW/UPDATED one of them.
window_rows() {
  local lines n
  lines="$(tput lines 2>/dev/null || printf '24')"
  [[ "$lines" =~ ^[0-9]+$ ]] || lines=24
  # Leave room for the two header lines, the elision line, and the prompt.
  n=$((lines - 5))
  [[ "$n" -lt 3 ]] && n=3
  printf '%s' "$n"
}

# The first row still worth watching: everything above it has finished, so it is
# what scrolls away first when the queue outgrows the window.
first_unfinished() {
  local i
  for ((i = 0; i < ${#q_pr[@]}; i++)); do
    case "${q_state[i]}" in
      done|failed|timeout) ;;
      *) printf '%s' "$i"; return 0 ;;
    esac
  done
  printf '%s' "${#q_pr[@]}"
}

render() {
  if [[ "$tty" -ne 1 ]]; then return 0; fi
  local now="$1" i mark label elapsed total start end shown
  total="${#q_pr[@]}"
  start=0
  end="$total"
  if [[ "$total" -gt "$window_max" ]]; then
    start="$(first_unfinished)"
    if [[ $((start + window_max)) -gt "$total" ]]; then
      start=$((total - window_max))
    fi
    [[ "$start" -lt 0 ]] && start=0
    end=$((start + window_max))
  fi
  shown=0
  if [[ "$rendered_lines" -gt 0 ]]; then
    # Up, then erase everything below: the block can be one line shorter than
    # last time -- the "N more waiting" line disappears as the window reaches
    # the end of the queue -- and clearing only the rows we rewrite would leave
    # the last one standing for the rest of the pass.
    printf '\033[%dA\033[J' "$rendered_lines"
  fi
  if [[ "$start" -gt 0 ]]; then
    printf '\033[2K  ... %d finished, scrolled off (all of them are in the summary)\n' "$start"
    shown=$((shown + 1))
  fi
  for ((i = start; i < end; i++)); do
    case "${q_state[i]}" in
      queued)
        mark=" "; label="queued"; elapsed="" ;;
      running)
        mark="${spin_frames:$spin:1}"; label="reviewing"
        elapsed="$(fmt_dur $((now - q_start[i])))" ;;
      done)
        mark="+"; label="done"
        elapsed="$(fmt_dur $((q_end[i] - q_start[i])))" ;;
      failed)
        mark="x"; label="failed ($(job_outcome "$i"))"
        elapsed="$(fmt_dur $((q_end[i] - q_start[i])))" ;;
      timeout)
        mark="x"; label="timed out"
        elapsed="$(fmt_dur $((q_end[i] - q_start[i])))" ;;
      *)
        mark=" "; label="${q_state[i]}"; elapsed="" ;;
    esac
    printf '\033[2K  %s  #%-5s %-24s %8s\n' "$mark" "${q_pr[i]}" "$label" "$elapsed"
    shown=$((shown + 1))
  done
  if [[ "$end" -lt "$total" ]]; then
    printf '\033[2K  ... %d more waiting\n' $((total - end))
    shown=$((shown + 1))
  fi
  rendered_lines="$shown"
  spin=$(((spin + 1) % ${#spin_frames}))
}

run_pass() {
  local pass="$1"; shift
  pass_dir="$run_dir/pass-$pass"
  mkdir -p "$pass_dir"

  q_pr=("$@")
  local total="${#q_pr[@]}" i
  for ((i = 0; i < total; i++)); do
    q_state[i]="queued"; q_pid[i]=""; q_sid[i]=""; q_flag[i]=""
    q_resume[i]=0; q_start[i]=0; q_end[i]=0; q_status[i]=""
  done

  printf 'reviewing %d PR(s), %d at a time\n' "$total" "$jobs_max"
  printf 'logs: %s\n\n' "$pass_dir"
  rendered_lines=0
  # Measured once per pass rather than per redraw: a resize mid-pass is rare,
  # and this would otherwise fork a `tput` five times a second.
  window_max="$(window_rows)"

  local running=0 next=0 now status_file
  while :; do
    while [[ "$running" -lt "$jobs_max" && "$next" -lt "$total" ]]; do
      start_job "$next"
      next=$((next + 1))
      running=$((running + 1))
    done

    now="$(date +%s)"
    for ((i = 0; i < total; i++)); do
      if [[ "${q_state[i]}" != "running" ]]; then continue; fi
      status_file="$(job_file "$i" status)"
      if [[ -f "$status_file" ]]; then
        finish_job "$i" "$now" "$(cat "$status_file")"
        running=$((running - 1))
      elif job_vanished "${q_pid[i]}" && [[ ! -f "$status_file" ]]; then
        # The job is gone but left no status: killed from outside, or it could
        # not write. Without this the slot is held until --timeout, and
        # --timeout 0 means the pass never ends at all.
        finish_job "$i" "$now" "vanished"
        running=$((running - 1))
      elif [[ "$timeout" -gt 0 && $((now - q_start[i])) -ge "$timeout" ]]; then
        stop_job "${q_pid[i]}"
        finish_job "$i" "$now" "timeout"
        running=$((running - 1))
      fi
    done

    if [[ "$running" -eq 0 && "$next" -ge "$total" ]]; then break; fi
    render "$now"
    # 5 Hz is for the spinner. With no TTY there is nothing to animate, and a
    # review runs for minutes -- polling that fast would only fork subshells at
    # the machine that is also running the reviews.
    sleep "$poll_interval"
  done
  render "$(date +%s)"
  flush_notes
}

# Cost is claude's own accounting, straight out of the result envelope, so it is
# only ever there for the built-in reviewer.
job_cost() {
  local out c
  out="$(job_file "$1" json)"
  if [[ ! -s "$out" ]]; then printf '-'; return 0; fi
  c="$(jq -r 'if type == "object" then (.total_cost_usd // empty) else empty end' \
    "$out" 2>/dev/null || true)"
  if [[ "$c" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    LC_ALL=C printf '$%.2f' "$c"
  else
    printf '-'
  fi
}

print_summary() {
  local i rows result
  rows="PR"$'\t'"RESULT"$'\t'"TIME"$'\t'"COST"$'\t'"SESSION"$'\n'
  for ((i = 0; i < ${#q_pr[@]}; i++)); do
    case "${q_state[i]}" in
      done)    result="done" ;;
      timeout) result="timed out" ;;
      failed)  result="failed ($(job_outcome "$i"))" ;;
      *)       result="${q_state[i]}" ;;
    esac
    rows+="#${q_pr[i]}"$'\t'"$result"$'\t'
    rows+="$(fmt_dur $((q_end[i] - q_start[i])))"$'\t'
    rows+="$(job_cost "$i")"$'\t'"${q_sid[i]:--}"$'\n'
  done
  printf '\n'
  # `column` is not a hard dependency: it lives in util-linux, and the boxes
  # this tool is built for -- a slim CI image, a minimal container -- are
  # exactly the ones that ship without it. Losing the alignment is nothing;
  # failing here would throw away the session ids after every review has already
  # succeeded, and would end a babysit loop on its first pass.
  #
  # Aligned into a variable first, so a column that dies halfway cannot leave
  # half a table on screen ahead of the fallback.
  local aligned
  if aligned="$(printf '%s' "$rows" | column -t -s $'\t' 2>/dev/null)"; then
    printf '%s\n' "$aligned"
  else
    printf '%s' "$rows"
  fi
  printf '\nlogs: %s\n' "$pass_dir"
  printf 'reopen any review with: claude --resume <SESSION>\n'
}

pass_failures() {
  local i n=0
  for ((i = 0; i < ${#q_pr[@]}; i++)); do
    if [[ "${q_state[i]}" != "done" ]]; then n=$((n + 1)); fi
  done
  printf '%s' "$n"
}

# Ctrl-C must not leave reviews running: they would keep holding their sessions
# open, and the next --continue would refuse to resume them.
#
# Every job that has a pid and has not been accounted for, rather than only the
# ones marked running: a signal can land between the moment a job is spawned and
# the moment its state says so, and a job skipped here is a reviewer left alive.
stop_running_jobs() {
  local i
  for ((i = 0; i < ${#q_pr[@]}; i++)); do
    if [[ -z "${q_pid[i]}" ]]; then continue; fi
    case "${q_state[i]}" in
      done|failed|timeout) ;;
      *) stop_job "${q_pid[i]}" ;;
    esac
  done
}

show_cursor() {
  if [[ "$tty" -eq 1 ]]; then printf '\033[?25h'; fi
}

on_signal() {
  printf '\n'
  echo "interrupted; stopping running reviews" >&2
  stop_running_jobs
  # Interrupting is how a babysit loop is meant to end, and the reviews that
  # already finished are still worth reopening -- so hand back their session
  # ids rather than dropping them on the way out.
  if [[ "${#q_pr[@]}" -gt 0 ]]; then
    print_summary
  fi
  show_cursor
  exit 130
}

# HUP belongs here as much as INT does: the first use case for a headless run is
# an ssh session, and a dropped connection must stop the reviews rather than
# orphan them.
trap on_signal INT TERM HUP
trap show_cursor EXIT
if [[ "$tty" -eq 1 ]]; then printf '\033[?25l'; fi

# --- Passes ---------------------------------------------------------------
queue=("${numbers[@]}")
pass=1
failures=0
while :; do
  run_pass "$pass" "${queue[@]}"
  print_summary
  failures="$(pass_failures)"

  if [[ "$babysit" -ne 1 ]]; then break; fi

  # Read back from GitHub rather than inferred from what the agent said: the
  # review either landed as an approval or it did not, and a run that believed
  # its own report would babysit a PR it never actually approved. A PR that was
  # closed, or merged with no approving review, is finished too -- waiting for
  # an approval that is never coming would re-review it every interval forever.
  remaining=()
  for n in "${queue[@]}"; do
    done_because="$(pr_babysit_done "$n")"
    if [[ -n "$done_because" ]]; then
      printf '\nPR #%s is %s; dropping it from the babysit loop\n' "$n" "$done_because"
    else
      remaining+=("$n")
    fi
  done
  if [[ "${#remaining[@]}" -eq 0 ]]; then
    printf '\nnothing left to babysit\n'
    break
  fi

  queue=("${remaining[@]}")
  # The first pass pinned each session; every later pass resumes it whether or
  # not --continue was passed. Re-reviewing from scratch each interval would
  # throw away the findings the author is in the middle of answering.
  continue_sessions=1
  printf '\nnext check in %s (%d PR(s) left)\n' "$babysit_interval" "${#queue[@]}"
  sleep "$(interval_seconds "$babysit_interval")"
  pass=$((pass + 1))
done

# Exit nonzero when any review in the final pass did not complete cleanly, so a
# cron job or a CI step can tell a finished sweep from a broken one.
if [[ "$failures" -gt 0 ]]; then
  printf 'error: %d of %d review(s) failed\n' "$failures" "${#q_pr[@]}" >&2
  exit 1
fi
