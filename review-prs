#!/usr/bin/env bash
# review-prs: pick open non-draft PRs in the current repo and fan out a
# review command into a new terminal tab per selection.
#
# Per-tab command:
#   Each selected PR opens a tab that `cd`s to the repo root and runs the
#   review command (see $REVIEW_PRS_CMD below) with the PR number. By default
#   that is a non-interactive Claude Code panel review; override it to plug in
#   any reviewer (a shell function, another CLI, etc.).
#
# Display columns:
#   #NUM   ENGAGEMENT   REVIEW      TIME      AUTHOR   TITLE
# Engagement:
#   NEW     - you have not commented or reviewed
#   UPDATED - new comments / reviews / commits since your last engagement
#   SEEN    - you engaged, nothing new since
# Review:
#   CHANGES  - reviewDecision == CHANGES_REQUESTED
#   APPROVED - shown only with --all (otherwise filtered out)
#
# Sort: NEW first, UPDATED next, SEEN last; tie-break by most-recent activity.
# Terminal target is auto-detected: herdr (preferred), cmux, or Ghostty.
#
# --auto skips the picker: it fans out every NEW/UPDATED PR, running
# $REVIEW_PRS_AUTO_CMD (an "auto panel review" by default) instead of the
# normal review command in each tab.

set -euo pipefail

# --- Args ----------------------------------------------------------------
include_approved=0
include_dependabot=0
auto=0
print_help() {
  cat <<'EOF'
review-prs: pick open non-draft, unapproved PRs and fan out a review per PR.

Usage: review-prs [--auto] [--all] [--dependabot] [--help]

  --auto, -A        Skip the picker; fan out every NEW/UPDATED PR, running
                    $REVIEW_PRS_AUTO_CMD (default: an "auto panel review")
                    instead of $REVIEW_PRS_CMD in each tab.
  --all, -a         Include PRs already marked APPROVED (default: exclude).
  --dependabot, -d  Include Dependabot PRs (default: hidden; shown dimmed).
  --help, -h        Show this help.

Each selected PR opens a tab that cd's to the repo root and runs a review
command. Override the default via $REVIEW_PRS_CMD (the PR number replaces the
first "{}", or is appended if absent):
  REVIEW_PRS_CMD='claude --dangerously-skip-permissions "panel review {}"'  (default)
  REVIEW_PRS_CMD='review'                                                   (append form)

Your own PRs are always hidden -- this tool is for reviewing others' work.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --auto|-A)       auto=1; shift ;;
    --all|-a)        include_approved=1; shift ;;
    --dependabot|-d) include_dependabot=1; shift ;;
    --help|-h)       print_help; exit 0 ;;
    *)               printf 'unknown arg: %s\n' "$1" >&2; print_help >&2; exit 1 ;;
  esac
done

# Command run in each spawned tab to review a PR. The PR number is substituted
# for the first "{}" placeholder, or appended if no placeholder is present.
# Override to use your own reviewer, e.g.
#   REVIEW_PRS_CMD='review' review-prs                 # a shell function/alias
#   REVIEW_PRS_CMD='gh pr checkout {} && my-review' ...  # placeholder form
# (Set via a conditional, not "${VAR:-default}", since a literal "}" in the
# default's {} placeholder would prematurely close the parameter expansion.)
review_cmd="${REVIEW_PRS_CMD:-}"
[[ -z "$review_cmd" ]] && review_cmd='claude --dangerously-skip-permissions "panel review {}"'

# Command run in each spawned tab under --auto (see below). Same "{}"/append
# substitution as $REVIEW_PRS_CMD; override via $REVIEW_PRS_AUTO_CMD.
auto_review_cmd="${REVIEW_PRS_AUTO_CMD:-}"
[[ -z "$auto_review_cmd" ]] && auto_review_cmd='claude --dangerously-skip-permissions "auto panel review {}"'

# Author logins treated as bots: hidden unless --dependabot, dimmed when shown.
# Extend this anchored alternation as more AI coding bots appear, e.g.
#   bot_login_re='^(dependabot|renovate|copilot)'
bot_login_re='^dependabot'

# --- Dependency checks ----------------------------------------------------
# Belt-and-suspenders: brew lists these as formula dependencies, but the
# script may also be run standalone (curl-pipe-bash, manual install, etc.).
require() {
  command -v "$1" >/dev/null 2>&1 && return 0
  printf 'error: missing required command: %s\n' "$1" >&2
  [[ -n "${2:-}" ]] && printf '  install with: %s\n' "$2" >&2
  return 1
}

missing=0
require gh  "brew install gh"  || missing=1
require gum "brew install gum" || missing=1
require jq  "brew install jq"  || missing=1
[[ "$missing" -eq 0 ]] || exit 1

# --- Repo + user context --------------------------------------------------
if ! repo_json="$(gh repo view --json owner,name 2>&1)"; then
  echo "error: not a GitHub repo (or gh not authenticated)" >&2
  echo "$repo_json" >&2
  exit 1
fi
owner="$(jq -r '.owner.login' <<<"$repo_json")"
name="$(jq -r '.name' <<<"$repo_json")"
repo_root="$(git rev-parse --show-toplevel)"

# A `gh api` failure inside `me="$(...)"` does NOT trip `set -e` (command
# substitution in a simple assignment is exempt). An empty `$me` would then
# silently mislabel every PR's engagement, so check explicitly.
if ! me="$(gh api user --jq .login 2>&1)"; then
  echo "error: failed to fetch current GitHub user" >&2
  echo "$me" >&2
  exit 1
fi
if [[ -z "$me" ]]; then
  echo "error: gh api user returned empty login" >&2
  exit 1
fi

# --- Fetch open non-draft PRs + activity in one GraphQL call --------------
prs_json="$(gh api graphql \
  -F owner="$owner" -F name="$name" \
  -f query='
    query($owner:String!, $name:String!) {
      repository(owner:$owner, name:$name) {
        pullRequests(states:OPEN, first:50, orderBy:{field:UPDATED_AT, direction:DESC}) {
          nodes {
            number
            title
            isDraft
            updatedAt
            reviewDecision
            author { login }
            comments(last:100) { nodes { author { login } updatedAt } }
            reviews(last:100)  { nodes { author { login } submittedAt } }
            commits(last:100)  { nodes { commit { committedDate author { user { login } } } } }
          }
        }
      }
    }' \
  --jq '.data.repository.pullRequests.nodes | map(select(.isDraft == false))')"

# Always hide your own PRs -- this tool is for reviewing others' work.
prs_json="$(jq --arg me "$me" 'map(select((.author.login // "") != $me))' <<<"$prs_json")"

# Hide bot PRs (Dependabot et al.) unless --dependabot was passed.
if [[ "$include_dependabot" -eq 0 ]]; then
  prs_json="$(jq --arg botre "$bot_login_re" \
    'map(select((.author.login // "") | test($botre) | not))' <<<"$prs_json")"
fi

# Filter out APPROVED unless --all was passed.
if [[ "$include_approved" -eq 0 ]]; then
  prs_json="$(jq 'map(select(.reviewDecision != "APPROVED"))' <<<"$prs_json")"
fi

count="$(jq 'length' <<<"$prs_json")"
if [[ "$count" -eq 0 ]]; then
  hint=""
  [[ "$include_approved"   -eq 0 ]] && hint+=" --all (approved)"
  [[ "$include_dependabot" -eq 0 ]] && hint+=" --dependabot (bots)"
  if [[ -n "$hint" ]]; then
    printf 'no matching open PRs; try:%s\n' "$hint"
  else
    echo "no open non-draft PRs"
  fi
  exit 0
fi

# --- Build display rows ---------------------------------------------------
# jq emits "RANK\tUPDATED_AT\tBOT\t#NUM\tENGAGE\tREVIEW\tTIME\t@AUTHOR\tTITLE",
# then we sort by rank+recency and strip the two leading sort columns. The BOT
# flag (0/1) rides along as the first surviving column so we can dim bot rows
# after alignment without re-deriving the author.
now_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

sorted="$(jq -r --arg me "$me" --arg now "$now_iso" --arg botre "$bot_login_re" '
  def rel(ts):
    ((($now | fromdateiso8601) - (ts | fromdateiso8601)) | floor) as $s
    | if   $s < 60     then "\($s)s ago"
      elif $s < 3600   then "\(($s/60)   | floor)m ago"
      elif $s < 86400  then "\(($s/3600) | floor)h ago"
      else                  "\(($s/86400)| floor)d ago"
      end;

  .[]
  | . as $pr
  | (
      ($pr.comments.nodes // [] | map({at: .updatedAt,            who: (.author.login // "")})) +
      ($pr.reviews.nodes  // [] | map({at: .submittedAt,          who: (.author.login // "")})) +
      ($pr.commits.nodes  // [] | map({at: .commit.committedDate, who: (.commit.author.user.login // "")}))
    ) as $events
  | ($events | map(select(.at != null and .who == $me)) | map(.at) | sort | last) as $mine
  | ($events | map(select(.at != null and .who != $me)) | map(.at) | sort | last) as $other
  | (
      if   $mine  == null                     then "NEW"
      elif $other != null and $other > $mine  then "UPDATED"
      else                                         "SEEN"
      end
    ) as $engage
  | (
      if   $engage == "NEW"     then 0
      elif $engage == "UPDATED" then 1
      else                           2
      end
    ) as $rank
  | (
      if   .reviewDecision == "CHANGES_REQUESTED" then "CHANGES"
      elif .reviewDecision == "APPROVED"          then "APPROVED"
      else                                             "-"
      end
    ) as $review
  | (if (.author.login // "") | test($botre) then 1 else 0 end) as $bot
  | "\($rank)\t\(.updatedAt)\t\($bot)\t#\(.number)\t\($engage)\t\($review)\t\(rel(.updatedAt))\t@\(.author.login // "ghost")\t\(.title)"
' <<<"$prs_json" | sort -t $'\t' -k1,1n -k2,2r | cut -f3-)"

# --- Auto mode: no picker -------------------------------------------------
# Fan out every NEW/UPDATED PR, running $auto_review_cmd per tab. SEEN PRs are
# skipped on purpose -- nothing has changed since you last engaged, so an
# automated sweep has no reason to re-review them. $sorted columns are
# tab-separated: 1=bot 2=#NUM 3=engage 4=review 5=time 6=author 7=title.
if [[ "$auto" -eq 1 ]]; then
  review_cmd="$auto_review_cmd"
  numbers=()
  while IFS= read -r n; do
    [[ -z "$n" ]] && continue
    numbers+=("$n")
  done < <(awk -F'\t' '$3=="NEW" || $3=="UPDATED" { sub(/^#/, "", $2); print $2 }' <<<"$sorted")

  if [[ "${#numbers[@]}" -eq 0 ]]; then
    echo "no NEW or UPDATED PRs to auto-review"
    exit 0
  fi
  printf 'auto-reviewing %d PR(s): %s\n' "${#numbers[@]}" "$(printf '#%s ' "${numbers[@]}")"
else
  # Surviving columns: "BOT\t#NUM\t...\tTITLE". Align everything but the BOT
  # flag, then dim bot rows (256-color gray 245) so they read as lower-priority
  # noise. paste re-zips the flags with the aligned rows, preserving order.
  dim=$'\033[38;5;245m'
  reset=$'\033[0m'
  aligned="$(cut -f2- <<<"$sorted" | column -t -s $'\t')"
  display="$(paste -d $'\t' <(cut -f1 <<<"$sorted") <(printf '%s\n' "$aligned") \
    | while IFS=$'\t' read -r bot row; do
        if [[ "$bot" == "1" ]]; then
          printf '%s%s%s\n' "$dim" "$row" "$reset"
        else
          printf '%s\n' "$row"
        fi
      done)"

  # --- Picker -------------------------------------------------------------
  legend_text='NEW = unreviewed by you   UPDATED = activity since your last comment   SEEN = nothing new   CHANGES = changes requested'
  [[ "$include_dependabot" -eq 1 ]] && legend_text+='   (dimmed = Dependabot)'
  legend="$(gum style --foreground 240 "$legend_text")"

  selected="$(printf '%s\n' "$display" \
    | gum choose --no-limit \
        --header "Pick PRs to review (space toggles, enter confirms)
$legend" \
        --height 20 \
    || true)"

  if [[ -z "${selected// /}" ]]; then
    echo "no PRs selected"
    exit 0
  fi

  numbers=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ \#([0-9]+) ]]; then
      numbers+=("${BASH_REMATCH[1]}")
    fi
  done <<<"$selected"

  if [[ "${#numbers[@]}" -eq 0 ]]; then
    echo "error: could not parse PR numbers from selection" >&2
    exit 1
  fi
fi

# --- Terminal detection + spawn ------------------------------------------
spawn_in_herdr() {
  local cmd="$1"
  local out pane
  # tab create prints JSON; the new pane's id is at .result.root_pane.pane_id.
  out="$(herdr tab create --no-focus --label review 2>&1)"
  pane="$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null)"
  if [[ -z "$pane" ]]; then
    echo "error: could not parse herdr pane id from output: $out" >&2
    return 1
  fi
  herdr pane run "$pane" "$cmd"
}

spawn_in_cmux() {
  local cmd="$1"
  local out surface
  out="$(cmux new-surface)"
  surface="$(printf '%s' "$out" | grep -oE 'surface:[0-9]+' | head -1)"
  if [[ -z "$surface" ]]; then
    echo "error: could not parse cmux surface from output: $out" >&2
    return 1
  fi
  cmux send --surface "$surface" "$cmd"
  cmux send-key --surface "$surface" Return
}

spawn_in_ghostty() {
  local cmd="$1"
  osascript \
    -e 'on run argv' \
    -e '  set theCmd to item 1 of argv' \
    -e '  tell application "Ghostty" to activate' \
    -e '  tell application "System Events" to keystroke "t" using command down' \
    -e '  delay 0.4' \
    -e '  tell application "Ghostty"' \
    -e '    set newTab to selected tab of front window' \
    -e '    set newTerminal to focused terminal of newTab' \
    -e '    input text (theCmd & return) to newTerminal' \
    -e '  end tell' \
    -e 'end run' \
    -- "$cmd" >/dev/null
}

if [[ "${HERDR_ENV:-}" == "1" ]] && command -v herdr >/dev/null 2>&1; then
  spawner="herdr"
elif [[ -n "${CMUX_SURFACE_ID:-}" ]] && command -v cmux >/dev/null 2>&1; then
  spawner="cmux"
elif [[ "${TERM_PROGRAM:-}" == "ghostty" ]]; then
  if [[ "$(uname)" != "Darwin" ]]; then
    echo "error: Ghostty spawn requires macOS (AppleScript)" >&2
    exit 1
  fi
  spawner="ghostty"
else
  echo "error: no supported terminal detected" >&2
  echo "  expected HERDR_ENV=1, CMUX_SURFACE_ID, or TERM_PROGRAM=ghostty" >&2
  echo "  HERDR_ENV=${HERDR_ENV:-<unset>} CMUX_SURFACE_ID=${CMUX_SURFACE_ID:-<unset>} TERM_PROGRAM=${TERM_PROGRAM:-<unset>}" >&2
  exit 1
fi

for n in "${numbers[@]}"; do
  echo "spawning tab for PR #$n via $spawner"
  if [[ "$review_cmd" == *"{}"* ]]; then
    invocation="${review_cmd//\{\}/$n}"
  else
    invocation="$review_cmd $n"
  fi
  cmd="cd $(printf '%q' "$repo_root") && $invocation"
  case "$spawner" in
    herdr)   spawn_in_herdr   "$cmd" ;;
    cmux)    spawn_in_cmux    "$cmd" ;;
    ghostty) spawn_in_ghostty "$cmd"; sleep 0.3 ;;
  esac
done
