#!/usr/bin/env bash
# review-prs: pick open non-draft PRs in the current repo and fan out a
# review command into a new terminal tab per selection.
#
# For the same fan-out without tabs -- headless `claude -p` reviews with a
# progress display and a real exit status -- see the `autoreview` sibling.
# Both share lib/: PR listing, ranking, the picker, and session continuity.
#
# Per-tab command:
#   Each selected PR opens a tab that `cd`s to the repo root and runs the
#   review command (see $REVIEW_PRS_CMD below) with the PR number. By default
#   that is a non-interactive Claude Code panel review; override it to plug in
#   any reviewer (a shell function, another CLI, etc.).
#
# Display columns:
#   #NUM   ENGAGEMENT   REVIEW   SESSION   TIME   AUTHOR   TITLE
# Engagement:
#   NEW     - you have not commented or reviewed
#   UPDATED - new comments / reviews / commits since your last engagement
#   SEEN    - you engaged, nothing new since
# Review:
#   CHANGES  - reviewDecision == CHANGES_REQUESTED
#   APPROVED - shown only with --all (otherwise filtered out)
# Session:
#   RESUMABLE - an earlier review session exists; --continue reopens it
#   (the whole column is hidden when no PR is resumable)
#
# Sort: NEW first, UPDATED next, SEEN last; tie-break by most-recent activity.
# Terminal target is auto-detected: herdr (preferred), cmux, or Ghostty. Under
# herdr/cmux the enclosing workspace is renamed to $REVIEW_PRS_WORKSPACE
# (default "pr reviews"; set it empty to opt out) and each tab is named for its
# PR and mode ("PR 27 Review", "PR 27 Auto-Review", "PR 27 Recheck",
# "PR 27 Babysit") so review sessions are easy to spot. Both names are sticky,
# surviving the title escapes
# the review command emits as it runs. Ghostty tabs are left unnamed: it has no
# sticky-title API, and any title we set would be overwritten by the review
# command within seconds.
#
# --auto skips the picker: it fans out every NEW/UPDATED PR, running
# $REVIEW_PRS_AUTO_CMD instead of the normal review command in each tab. By
# default that invokes the `pr-review-tab` skill, which runs an auto-review
# and, when the PR is approved, closes the tab so a finished review cleans up
# after itself.
#
# --babysit turns on re-checking: a PR that doesn't come back approvable keeps
# its tab open and re-checks on an interval (default 30m, --babysit=MINUTES; a
# bare number is minutes, and 30m/1h/2d also work) until it can be approved,
# then closes the tab. It uses the same unattended
# command as --auto, so it works with the picker too (pick PRs, then babysit
# each). The close/loop behavior lives in the pr-review-tab skill, not here --
# this script only seeds the command into each tab.
#
# Session continuity: each PR gets a session id derived from the repo directory
# plus owner/name#NUM, so the same PR in the same checkout maps to the same
# Claude Code session on every run. A first review pins that id with
# --session-id; --continue reopens it with --resume, and the tab re-checks the
# PR against the review already in that session instead of starting over.
# Sessions are local to this machine, and to the checkout the tab cd's into: a
# second clone or a git worktree of the same repo keeps its own sessions.

set -euo pipefail

# --- Library --------------------------------------------------------------
# Resolve this file through any symlinks before looking for lib/: the documented
# manual install symlinks the entry point into /usr/local/bin, and the library
# lives next to the real file, not next to the link.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
lib_dir="$(cd "$(dirname "$self")/lib" 2>/dev/null && pwd)" || {
  printf 'error: cannot find lib/ next to %s\n' "$self" >&2
  exit 1
}
# shellcheck source=lib/interval.sh
. "$lib_dir/interval.sh"
# shellcheck source=lib/repo.sh
. "$lib_dir/repo.sh"
# shellcheck source=lib/session.sh
. "$lib_dir/session.sh"
# shellcheck source=lib/pr-list.sh
. "$lib_dir/pr-list.sh"

# --- Args ----------------------------------------------------------------
include_approved=0
include_dependabot=0
auto=0
babysit=0
continue_sessions=0
print_help() {
  cat <<'EOF'
review-prs: pick open non-draft, unapproved PRs and fan out a review per PR.

Usage: review-prs [--auto] [--babysit[=MINUTES]] [--continue] [--all]
                  [--dependabot] [--help]

  --auto, -A          Skip the picker; fan out every NEW/UPDATED PR, running
                      $REVIEW_PRS_AUTO_CMD (default: the pr-review-tab skill,
                      which auto-reviews and closes the tab on approval)
                      instead of $REVIEW_PRS_CMD in each tab.
  --babysit[=MIN], -b Re-check any PR that doesn't come back approvable every
                      MIN minutes (default 30, or $REVIEW_PRS_BABYSIT_INTERVAL)
                      until it can be approved, then close its tab. Uses the
                      unattended command, so it works with the picker too.
                      A bare number is minutes; 30m/1h/2d also work.
  --continue, -C      Resume this machine's earlier review session for a PR
                      instead of reviewing it from scratch. PRs with a session
                      are marked RESUMABLE in the picker.
  --all, -a           Include PRs already marked APPROVED (default: exclude).
  --dependabot, -d    Include Dependabot PRs (default: hidden; shown dimmed).
  --help, -h          Show this help.

Each selected PR opens a tab that cd's to the repo root and runs a review
command. The built-in commands are:
  claude --dangerously-skip-permissions --session-id UUID "panel review N"
  claude --dangerously-skip-permissions --resume     UUID "recheck-pr N"   (-C)
where UUID is derived from the repo directory plus owner/name#N, so the same PR
in this checkout always maps to the same session. Override via $REVIEW_PRS_CMD
(the PR number replaces the first "{}", or is appended if absent):
  REVIEW_PRS_CMD='review'                              (append form)
  REVIEW_PRS_CMD='gh pr checkout {} && my-review {}'   (placeholder form)
An overridden command owns its own session handling; it receives the id as
$REVIEW_PRS_SESSION_ID and a 0/1 $REVIEW_PRS_SESSION_RESUME.

Under herdr/cmux the enclosing workspace is renamed to $REVIEW_PRS_WORKSPACE
(default "pr reviews"); set it empty to leave your workspace title alone.

To review the same PRs headlessly instead -- no tabs, a progress display, and
an exit status that reports the reviews rather than the spawns -- use
`autoreview`, which takes the same flags.

Your own PRs are always hidden -- this tool is for reviewing others' work.
EOF
}

# Kept raw until after arg parsing: validating here would make a bad
# $REVIEW_PRS_BABYSIT_INTERVAL in your shell profile hard-fail every run,
# including --help and ordinary picker runs that never babysit.
babysit_interval_raw="${REVIEW_PRS_BABYSIT_INTERVAL:-30}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --auto|-A)       auto=1; shift ;;
    --babysit|-b)    babysit=1; shift ;;
    --babysit=*)     babysit=1; babysit_interval_raw="${1#*=}"; shift ;;
    --continue|-C)   continue_sessions=1; shift ;;
    --all|-a)        include_approved=1; shift ;;
    --dependabot|-d) include_dependabot=1; shift ;;
    --help|-h)       print_help; exit 0 ;;
    *)               printf 'unknown arg: %s\n' "$1" >&2; print_help >&2; exit 1 ;;
  esac
done

# Now that --help and arg errors are out of the way, validate the interval --
# but only when babysitting is actually on, so an unrelated bad env var never
# blocks a plain review run.
babysit_interval=""
if [[ "$babysit" -eq 1 ]]; then
  babysit_interval="$(normalize_interval "$babysit_interval_raw")" || exit 1
fi

# Command run in each spawned tab to review a PR, and its unattended twin for
# --auto / --babysit. Both are empty by default, which means "use the built-in
# claude invocation" -- see builtin_invocation, which needs the PR number and
# the session state to pick its flags and prompt, so it cannot be flattened into
# a template string here. A non-empty value is a user override: the PR number
# replaces the first "{}", or is appended if no placeholder is present, e.g.
#   REVIEW_PRS_CMD='review' review-prs                   # a shell function/alias
#   REVIEW_PRS_CMD='gh pr checkout {} && my-review' ...  # placeholder form
review_cmd="${REVIEW_PRS_CMD:-}"
auto_review_cmd="${REVIEW_PRS_AUTO_CMD:-}"

if [[ -n "$auto_review_cmd" && "$babysit" -eq 1 ]]; then
  # An overridden unattended command owns its own re-check behavior and has no
  # documented slot for the interval, so --babysit=MIN cannot reach it. Say so
  # rather than let the flag look effective.
  printf 'note: $REVIEW_PRS_AUTO_CMD is set; --babysit interval (%s) is not passed to it\n' \
    "$babysit_interval" >&2
fi

# Command choice is independent of how PRs are selected: any unattended run
# (--auto sweep OR --babysit picker) takes the unattended override, so the tab
# self-closes on approval; a plain picker run keeps the interactive one. From
# here on $review_cmd is "the override to run", and empty means "built-in".
if [[ "$auto" -eq 1 || "$babysit" -eq 1 ]]; then
  review_cmd="$auto_review_cmd"
fi

# --- Context + selection --------------------------------------------------
require_deps gh gum jq
load_repo_context
# `if`, not `&&`: a false test as the last statement of a line would trip
# errexit and exit the script before anything is selected.
if [[ "$continue_sessions" -eq 1 ]]; then
  require_session_ids
fi
select_prs

# --- Terminal detection + spawn ------------------------------------------
spawn_in_herdr() {
  local cmd="$1" label="$2"
  local out pane
  # tab create prints JSON on stdout; the new pane's id is at
  # .result.root_pane.pane_id. Two things this must not do: merge stderr into
  # $out (herdr noise would corrupt the JSON and fail the jq parse below), or
  # leave a failing command unreported. The spawn loop calls this function with
  # `||`, which switches errexit off for this entire body -- nothing in here
  # fails loudly on its own, so every step is checked explicitly.
  #
  # --workspace pins the tab to the workspace we renamed; without it herdr may
  # place tabs in whichever workspace the UI happens to have focused.
  if ! out="$(herdr tab create ${HERDR_WORKSPACE_ID:+--workspace "$HERDR_WORKSPACE_ID"} \
                --no-focus --label "$label")"; then
    echo "error: herdr tab create failed for '$label' (see herdr output above)" >&2
    return 1
  fi
  pane="$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null || true)"
  if [[ -z "$pane" ]]; then
    echo "error: could not parse herdr pane id from output: $out" >&2
    return 1
  fi
  # Guarded for the same reason as the cmux path (errexit is off inside this
  # body). Report the orphan explicitly: the tab exists and is labelled, so a
  # bare "skipped" would understate what got left behind.
  if ! herdr pane run "$pane" "$cmd" >/dev/null; then
    echo "error: herdr pane run failed for '$label'; tab was created but is empty" >&2
    return 1
  fi
}

spawn_in_cmux() {
  local cmd="$1" label="$2"
  local out surface
  # Guarded for the same reason as the herdr path: errexit is off inside this
  # body, so a failing `cmux new-surface` would otherwise fall through to the
  # parse below and report a confusing "could not parse" instead of the truth.
  if ! out="$(cmux new-surface)"; then
    echo "error: cmux new-surface failed for '$label' (see cmux output above)" >&2
    return 1
  fi
  surface="$(printf '%s' "$out" | grep -oE 'surface:[0-9]+' | head -1 || true)"
  if [[ -z "$surface" ]]; then
    echo "error: could not parse cmux surface from output: $out" >&2
    return 1
  fi
  # Best-effort, like the workspace rename: a naming failure must not abort the
  # fan-out. Renaming before the command runs means the tab is labelled from the
  # first frame rather than flashing an untitled tab.
  cmux rename-tab --surface "$surface" "$label" >/dev/null 2>&1 || true
  # Guard each command explicitly. The spawn loop calls this function with `||`,
  # which disables errexit for the entire body -- so a bare `cmux send` failure
  # would be masked by the send-key after it, and an empty tab would be reported
  # as a successful spawn.
  if ! cmux send --surface "$surface" "$cmd"; then
    echo "error: cmux send failed for '$label'" >&2
    return 1
  fi
  if ! cmux send-key --surface "$surface" Return; then
    echo "error: cmux send-key failed for '$label'" >&2
    return 1
  fi
}

spawn_in_ghostty() {
  local cmd="$1"
  osascript \
    -e 'on run argv' \
    -e '  set theCmd to item 1 of argv' \
    -e '  tell application "Ghostty" to activate' \
    -e '  tell application "System Events" to keystroke "t" using command down' \
    -e '  delay 0.4' \
    -e '  tell application "Ghostty"' \
    -e '    set newTab to selected tab of front window' \
    -e '    set newTerminal to focused terminal of newTab' \
    -e '    input text (theCmd & return) to newTerminal' \
    -e '  end tell' \
    -e 'end run' \
    -- "$cmd" >/dev/null
}

# The built-in claude invocation for one PR: which session flag to use, and the
# prompt that goes with it. Resuming and reviewing from scratch are different
# jobs, so they get different prompts -- a resumed session already holds the
# earlier review, which is exactly what recheck-pr needs and what a fresh
# panel-review would throw away.
#   $2 is the session flag ("--session-id UUID", "--resume UUID", or empty),
#   $3 is 1 when that flag resumes an existing session.
builtin_invocation() {
  local n="$1" session_flag="$2" resume="$3" prompt
  if [[ "$auto" -eq 1 || "$babysit" -eq 1 ]]; then
    # Unattended: always the pr-review-tab skill, so the tab still self-closes
    # on approval and still loops under --babysit. --recheck tells it to pick up
    # the review in the resumed session instead of running a fresh auto-review.
    prompt="pr-review-tab $n"
    [[ "$resume"  -eq 1 ]] && prompt+=" --recheck"
    [[ "$babysit" -eq 1 ]] && prompt+=" --babysit $babysit_interval"
  elif [[ "$resume" -eq 1 ]]; then
    prompt="recheck-pr $n"
  else
    prompt="panel review $n"
  fi
  printf 'claude --dangerously-skip-permissions %s"%s"' \
    "${session_flag:+$session_flag }" "$prompt"
}

# Name each tab for its PR and what that tab is actually doing, e.g.
# "PR 27 Review" / "PR 27 Babysit". Babysit wins over auto when both are set:
# it is the more specific behavior (re-check on an interval until approvable).
# Under herdr/cmux this name is sticky -- it survives the title escapes the
# review command emits as it runs, which would otherwise overwrite it with a
# generic agent-generated summary.
tab_label() {
  local n="$1" resume="$2"
  if   [[ "$babysit" -eq 1 ]]; then printf 'PR %s Babysit'     "$n"
  elif [[ "$resume"  -eq 1 ]]; then printf 'PR %s Recheck'     "$n"
  elif [[ "$auto"    -eq 1 ]]; then printf 'PR %s Auto-Review' "$n"
  else                              printf 'PR %s Review'      "$n"
  fi
}

# Rename the enclosing workspace so review sessions stand out in the tab/session
# switcher. Best-effort: a rename failure must never abort the fan-out, and
# Ghostty has no workspace concept, so it is skipped.
rename_workspace() {
  # `-` not `:-`: an explicitly empty REVIEW_PRS_WORKSPACE= opts out entirely,
  # leaving the workspace you launched from with the title you gave it.
  local label="${REVIEW_PRS_WORKSPACE-pr reviews}"
  [[ -n "$label" ]] || return 0
  case "$spawner" in
    herdr)
      [[ -n "${HERDR_WORKSPACE_ID:-}" ]] || return 0
      herdr workspace rename "$HERDR_WORKSPACE_ID" "$label" >/dev/null 2>&1 || true
      ;;
    cmux)
      cmux workspace-action --action rename --title "$label" >/dev/null 2>&1 || true
      ;;
  esac
}

if [[ "${HERDR_ENV:-}" == "1" ]] && command -v herdr >/dev/null 2>&1; then
  spawner="herdr"
elif [[ -n "${CMUX_SURFACE_ID:-}" ]] && command -v cmux >/dev/null 2>&1; then
  spawner="cmux"
elif [[ "${TERM_PROGRAM:-}" == "ghostty" ]]; then
  if [[ "$(uname)" != "Darwin" ]]; then
    echo "error: Ghostty spawn requires macOS (AppleScript)" >&2
    exit 1
  fi
  spawner="ghostty"
else
  echo "error: no supported terminal detected" >&2
  echo "  expected HERDR_ENV=1, CMUX_SURFACE_ID, or TERM_PROGRAM=ghostty" >&2
  echo "  HERDR_ENV=${HERDR_ENV:-<unset>} CMUX_SURFACE_ID=${CMUX_SURFACE_ID:-<unset>} TERM_PROGRAM=${TERM_PROGRAM:-<unset>}" >&2
  echo "  (for a headless fan-out that needs no terminal, use: autoreview)" >&2
  exit 1
fi

rename_workspace

spawn_failures=0

for n in "${numbers[@]}"; do
  # Decide this PR's session before anything else: the flag, the prompt and the
  # tab label all follow from it.
  plan_session "$n"
  sid="$session_id"
  resume="$session_resume"

  if [[ "$resume" -eq 1 ]]; then
    echo "spawning tab for PR #$n via $spawner (resuming earlier review)"
  else
    echo "spawning tab for PR #$n via $spawner"
  fi

  # Environment handed to an overridden command, as a statement that runs before
  # the `cd` rather than a prefix on it. Two things this shape gets right that an
  # assignment prefix does not: an override may be a compound command -- the help
  # text documents `gh pr checkout {} && my-review {}` -- and a prefix reaches
  # only the first command of it; and putting the `export` ahead of the `cd`
  # keeps the `cd ... &&` guard covering the override itself, so a failed cd
  # still stops the review from running in the wrong directory.
  env_prefix=""
  if [[ -n "$review_cmd" ]]; then
    if [[ "$review_cmd" == *"{}"* ]]; then
      invocation="${review_cmd//\{\}/$n}"
    else
      invocation="$review_cmd $n"
    fi
    # An overridden command owns its own session handling, so hand it the id and
    # let it decide. These have to ride in the command string: the tab is a new
    # shell spawned by the terminal, not a child of this process, so exporting
    # them here would never reach it.
    env_prefix="export REVIEW_PRS_SESSION_ID=$(printf '%q' "$sid") REVIEW_PRS_SESSION_RESUME=$resume; "
  else
    invocation="$(builtin_invocation "$n" "$session_flag" "$resume")"
  fi

  cmd="${env_prefix}cd $(printf '%q' "$repo_root") && $invocation"
  label="$(tab_label "$n" "$resume")"
  # A tab that fails to spawn must not take the rest of the sweep with it: warn
  # and keep going, so one bad tab costs you one review, not all of them. The
  # count is what the exit status reports -- see below.
  spawned=0
  case "$spawner" in
    herdr)   spawn_in_herdr   "$cmd" "$label" && spawned=1 ;;
    cmux)    spawn_in_cmux    "$cmd" "$label" && spawned=1 ;;
    ghostty) spawn_in_ghostty "$cmd"          && spawned=1; sleep 0.3 ;;
  esac
  if [[ "$spawned" -eq 0 ]]; then
    echo "warning: skipped PR #$n" >&2
    spawn_failures=$((spawn_failures + 1))
  fi
done

# Exit nonzero when any tab failed. A sweep that spawned nothing must not look
# like a successful one to whatever ran it -- `review-prs --auto` in a script or
# a cron job would otherwise report success having started no reviews.
if [[ "$spawn_failures" -gt 0 ]]; then
  printf 'error: %d of %d tab(s) failed to spawn\n' "$spawn_failures" "${#numbers[@]}" >&2
  exit 1
fi
