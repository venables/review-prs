#!/usr/bin/env bash
# review-prs: pick open non-draft PRs in the current repo and fan out
# `review <num>` into a new terminal tab per selection.
#
# Display columns:
#   #NUM   ENGAGEMENT   REVIEW      TIME      AUTHOR   TITLE
# Engagement:
#   NEW     - you have not commented or reviewed
#   UPDATED - new comments / reviews / commits since your last engagement
#   SEEN    - you engaged, nothing new since
# Review:
#   CHANGES  - reviewDecision == CHANGES_REQUESTED
#   APPROVED - shown only with --all (otherwise filtered out)
#
# Sort: NEW first, UPDATED next, SEEN last; tie-break by most-recent activity.
# Terminal target is auto-detected: cmux (preferred) or Ghostty.

set -euo pipefail

# --- Args ----------------------------------------------------------------
include_approved=0
print_help() {
  cat <<'EOF'
review-prs: pick open non-draft, unapproved PRs and fan out `review N`.

Usage: review-prs [--all] [--help]

  --all, -a    Include PRs already marked APPROVED (default: exclude).
  --help, -h   Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all|-a)  include_approved=1; shift ;;
    --help|-h) print_help; exit 0 ;;
    *)         printf 'unknown arg: %s\n' "$1" >&2; print_help >&2; exit 1 ;;
  esac
done

# --- Dependency checks ----------------------------------------------------
# Belt-and-suspenders: brew lists these as formula dependencies, but the
# script may also be run standalone (curl-pipe-bash, manual install, etc.).
require() {
  command -v "$1" >/dev/null 2>&1 && return 0
  printf 'error: missing required command: %s\n' "$1" >&2
  [[ -n "${2:-}" ]] && printf '  install with: %s\n' "$2" >&2
  return 1
}

missing=0
require gh  "brew install gh"  || missing=1
require gum "brew install gum" || missing=1
require jq  "brew install jq"  || missing=1
[[ "$missing" -eq 0 ]] || exit 1

# --- Repo + user context --------------------------------------------------
if ! repo_json="$(gh repo view --json owner,name 2>&1)"; then
  echo "error: not a GitHub repo (or gh not authenticated)" >&2
  echo "$repo_json" >&2
  exit 1
fi
owner="$(jq -r '.owner.login' <<<"$repo_json")"
name="$(jq -r '.name' <<<"$repo_json")"
repo_root="$(git rev-parse --show-toplevel)"

# A `gh api` failure inside `me="$(...)"` does NOT trip `set -e` (command
# substitution in a simple assignment is exempt). An empty `$me` would then
# silently mislabel every PR's engagement, so check explicitly.
if ! me="$(gh api user --jq .login 2>&1)"; then
  echo "error: failed to fetch current GitHub user" >&2
  echo "$me" >&2
  exit 1
fi
if [[ -z "$me" ]]; then
  echo "error: gh api user returned empty login" >&2
  exit 1
fi

# --- Fetch open non-draft PRs + activity in one GraphQL call --------------
prs_json="$(gh api graphql \
  -F owner="$owner" -F name="$name" \
  -f query='
    query($owner:String!, $name:String!) {
      repository(owner:$owner, name:$name) {
        pullRequests(states:OPEN, first:50, orderBy:{field:UPDATED_AT, direction:DESC}) {
          nodes {
            number
            title
            isDraft
            updatedAt
            reviewDecision
            author { login }
            comments(last:100) { nodes { author { login } updatedAt } }
            reviews(last:100)  { nodes { author { login } submittedAt } }
            commits(last:100)  { nodes { commit { committedDate author { user { login } } } } }
          }
        }
      }
    }' \
  --jq '.data.repository.pullRequests.nodes | map(select(.isDraft == false))')"

# Filter out APPROVED unless --all was passed.
if [[ "$include_approved" -eq 0 ]]; then
  prs_json="$(jq 'map(select(.reviewDecision != "APPROVED"))' <<<"$prs_json")"
fi

count="$(jq 'length' <<<"$prs_json")"
if [[ "$count" -eq 0 ]]; then
  if [[ "$include_approved" -eq 0 ]]; then
    echo "no open non-draft, unapproved PRs (pass --all to include approved)"
  else
    echo "no open non-draft PRs"
  fi
  exit 0
fi

# --- Build display rows ---------------------------------------------------
# jq emits "RANK\tUPDATED_AT\t#NUM\tENGAGE\tREVIEW\tTIME\t@AUTHOR\tTITLE",
# then we sort by rank+recency and strip the two leading sort columns.
now_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

rows="$(jq -r --arg me "$me" --arg now "$now_iso" '
  def rel(ts):
    ((($now | fromdateiso8601) - (ts | fromdateiso8601)) | floor) as $s
    | if   $s < 60     then "\($s)s ago"
      elif $s < 3600   then "\(($s/60)   | floor)m ago"
      elif $s < 86400  then "\(($s/3600) | floor)h ago"
      else                  "\(($s/86400)| floor)d ago"
      end;

  .[]
  | . as $pr
  | (
      ($pr.comments.nodes // [] | map({at: .updatedAt,            who: (.author.login // "")})) +
      ($pr.reviews.nodes  // [] | map({at: .submittedAt,          who: (.author.login // "")})) +
      ($pr.commits.nodes  // [] | map({at: .commit.committedDate, who: (.commit.author.user.login // "")}))
    ) as $events
  | ($events | map(select(.at != null and .who == $me)) | map(.at) | sort | last) as $mine
  | ($events | map(select(.at != null and .who != $me)) | map(.at) | sort | last) as $other
  | (
      if   $mine  == null                     then "NEW"
      elif $other != null and $other > $mine  then "UPDATED"
      else                                         "SEEN"
      end
    ) as $engage
  | (
      if   $engage == "NEW"     then 0
      elif $engage == "UPDATED" then 1
      else                           2
      end
    ) as $rank
  | (
      if   .reviewDecision == "CHANGES_REQUESTED" then "CHANGES"
      elif .reviewDecision == "APPROVED"          then "APPROVED"
      else                                             "-"
      end
    ) as $review
  | "\($rank)\t\(.updatedAt)\t#\(.number)\t\($engage)\t\($review)\t\(rel(.updatedAt))\t@\(.author.login // "ghost")\t\(.title)"
' <<<"$prs_json" | sort -t $'\t' -k1,1n -k2,2r | cut -f3-)"

# Align columns visually before passing to gum.
display="$(printf '%s\n' "$rows" | column -t -s $'\t')"

# --- Picker ---------------------------------------------------------------
legend="$(gum style --foreground 240 \
  'NEW = unreviewed by you   UPDATED = activity since your last comment   SEEN = nothing new   CHANGES = changes requested')"

selected="$(printf '%s\n' "$display" \
  | gum choose --no-limit \
      --header "Pick PRs to review (space toggles, enter confirms)
$legend" \
      --height 20 \
  || true)"

if [[ -z "${selected// /}" ]]; then
  echo "no PRs selected"
  exit 0
fi

numbers=()
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  if [[ "$line" =~ \#([0-9]+) ]]; then
    numbers+=("${BASH_REMATCH[1]}")
  fi
done <<<"$selected"

if [[ "${#numbers[@]}" -eq 0 ]]; then
  echo "error: could not parse PR numbers from selection" >&2
  exit 1
fi

# --- Terminal detection + spawn ------------------------------------------
spawn_in_cmux() {
  local cmd="$1"
  local out surface
  out="$(cmux new-surface)"
  surface="$(printf '%s' "$out" | grep -oE 'surface:[0-9]+' | head -1)"
  if [[ -z "$surface" ]]; then
    echo "error: could not parse cmux surface from output: $out" >&2
    return 1
  fi
  cmux send --surface "$surface" "$cmd"
  cmux send-key --surface "$surface" Return
}

spawn_in_ghostty() {
  local cmd="$1"
  osascript \
    -e 'on run argv' \
    -e '  set theCmd to item 1 of argv' \
    -e '  tell application "Ghostty" to activate' \
    -e '  tell application "System Events" to keystroke "t" using command down' \
    -e '  delay 0.4' \
    -e '  tell application "Ghostty"' \
    -e '    set newTab to selected tab of front window' \
    -e '    set newTerminal to focused terminal of newTab' \
    -e '    input text (theCmd & return) to newTerminal' \
    -e '  end tell' \
    -e 'end run' \
    -- "$cmd" >/dev/null
}

if [[ -n "${CMUX_SURFACE_ID:-}" ]] && command -v cmux >/dev/null 2>&1; then
  spawner="cmux"
elif [[ "${TERM_PROGRAM:-}" == "ghostty" ]]; then
  if [[ "$(uname)" != "Darwin" ]]; then
    echo "error: Ghostty spawn requires macOS (AppleScript)" >&2
    exit 1
  fi
  spawner="ghostty"
else
  echo "error: no supported terminal detected" >&2
  echo "  expected CMUX_SURFACE_ID or TERM_PROGRAM=ghostty" >&2
  echo "  TERM_PROGRAM=${TERM_PROGRAM:-<unset>} CMUX_SURFACE_ID=${CMUX_SURFACE_ID:-<unset>}" >&2
  exit 1
fi

for n in "${numbers[@]}"; do
  echo "spawning tab for PR #$n via $spawner"
  cmd="cd $(printf '%q' "$repo_root") && review $n"
  case "$spawner" in
    cmux)    spawn_in_cmux    "$cmd" ;;
    ghostty) spawn_in_ghostty "$cmd"; sleep 0.3 ;;
  esac
done
